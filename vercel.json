{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "services": {
        "api": {
            "root": ".",
            "entrypoint": "docker/php/Dockerfile.prod",
            "runtime": "container"
        }
    },
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": {
                "service": "api"
            }
        }
    ]
}
